# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Supabase Postgres connection string (Project Settings -> Database ->
# Connection string -> Session pooler). Rewrite the scheme to
# `postgresql+psycopg://` so SQLAlchemy uses the psycopg 3 driver, e.g.:
#   postgresql+psycopg://postgres:<password>@<host>:5432/postgres
DATABASE_URL=

# Claude API key (sk-ant-...). Optional for M0 — if blank, the backend still
# runs and /health reports "llm_configured": false. Used only server-side.
ANTHROPIC_API_KEY=
