# Sentra Authority Engine - Environment Configuration
# Copy this file to `.env` (gitignored).

# Optional database URL (SQLite default fallback sqlite:///./backend.db used if blank)
DATABASE_URL=

# Master Capability Signing Secret (HMAC-SHA256)
SECRET_KEY=sentra-authority-master-signing-key-hackathon-2026

# Policy Version Tag
POLICY_VERSION=v1.0.0-sentra-kernel
